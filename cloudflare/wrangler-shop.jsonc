{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "archenlicht-shop-preview",
  "main": "../dist-cloudflare-shop/worker/worker.js",
  "compatibility_date": "2026-11-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "no_bundle": true,
  "find_additional_modules": true,
  "assets": {
    "directory": "../dist-cloudflare-shop/public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "durable_objects": {
    "bindings": [{ "name": "SHOP", "class_name": "MigrationShop" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MigrationShop"] }],
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
