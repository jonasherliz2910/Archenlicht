# Ohne diese Datei startet der vollständig lokale Testbetrieb.
SHOP_MODE=test
HOST=127.0.0.1
PORT=3000
BASE_URL=http://localhost:3000
DATA_DIR=./data/test
PAYMENT_MODE=local
PODBASE_MODE=local
PRINT_MODE=preview
# PRINT_MODE=podbase erzeugt volle 2000x3400-Druckdateien mit Originalschablonen.
# Modelle ohne belegte Druckvorlage bleiben dann nicht bestellbar.
# PODBASE_MODE=catalog verbindet nur Katalog und Bestand mit dem echten Konto.
# Bestellübertragung und Produktion bleiben auch dann lokal simuliert.
MAIL_MODE=local
# Optionaler echter Mailversand ausschließlich für neue, freigegebene Testempfänger.
# MAIL_MODE=resend-test erst nach Einrichtung des Resend-Webhooks verwenden.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
MAIL_PUBLIC_URL=https://www.archenlicht.de
MAIL_TEST_RECIPIENTS=info@archenlicht.de
# ISO-Startzeit; Bestellungen vor diesem Zeitpunkt werden nie nachträglich versandt.
MAIL_ENABLED_SINCE=
# Lokal erzeugt der Start ein einmaliges Adminpasswort in data/test/admin-access.txt.
ADMIN_EMAIL=jonas@archenlicht.test
ADMIN_PASSWORD=
# Stripe Checkout mit den im Dashboard verfügbaren Zahlungsarten (PAYMENT_MODE=sandbox).
# Bevorzugt eingeschränkter rk_test_-Schlüssel; sk_test_ wird ebenfalls unterstützt.
# Keine Live-Schlüssel. PayPal muss im Stripe-Konto verfügbar und aktiviert sein.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: eigene Zahlungsmethoden-Konfiguration aus Stripe (pmc_...).
STRIPE_PAYMENT_CONFIGURATION=
# Zusätzliche eigene HTTPS-Shopdomains, kommagetrennt; kein abschließender Slash.
SHOP_ALLOWED_ORIGINS=
# Für PODBASE_MODE=catalog erforderlich; ausschließlich serverseitig speichern.
PODBASE_API_KEY=
PODBASE_BASE_URL=https://open-api.podbase.com
PRINT_BASE_URL=
SESSION_HOURS=2
# Vercel setzt DATABASE_URL automatisch über die Neon-Integration.
# Ohne Vercel bleibt STORAGE_MODE=sqlite der lokale Standard.
STORAGE_MODE=sqlite
DATABASE_URL=
DATABASE_SCHEMA=public
# Nur für den geschützten, geplanten Test-Worker:
CRON_SECRET=
