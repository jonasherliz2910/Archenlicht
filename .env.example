# Ohne diese Datei startet der vollständig lokale Testbetrieb.
SHOP_MODE=test
HOST=127.0.0.1
PORT=3000
BASE_URL=http://localhost:3000
DATA_DIR=./data/test
PAYMENT_MODE=local
PODBASE_MODE=local
